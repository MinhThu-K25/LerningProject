@model QuanLyThuVien.Models.AppUser
@{
    ViewData["Title"] = "Thông Tin Cá Nhân";
}

<style>
    :root {
        --electron-blue: #00d4ff;
        --neon-glow: 0 0 15px rgba(0, 212, 255, 0.6);
        --dark-bg: #050a18;
        --card-bg: rgba(17, 34, 64, 0.8);
    }

    body {
        background: radial-gradient(circle at center, #0a192f 0%, #050a18 100%);
        color: #e6f1ff;
        font-family: 'Roboto', sans-serif;
        min-height: 100vh;
        margin: 0;
        overflow-x: hidden;
    }


    /* Container chính */
    .main-wrapper {
        padding-top: 100px;
        padding-bottom: 50px;
        padding: 50px 20px; /* Cách trên và dưới 50px để không dính Header/Footer */
    }

    /* Profile Card lột xác */
    .profile-card {
        margin-bottom: 46px; /* Cách footer một khoảng 30px */
        background: var(--card-bg);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(0, 212, 255, 0.3);
        border-radius: 25px;
        padding: 40px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
        position: relative;
        overflow: hidden;
    }

        .profile-card::before {
            content: "";
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: conic-gradient(transparent, transparent, transparent, var(--electron-blue));
            animation: rotate 6s linear infinite;
            z-index: -1;
            opacity: 0.2;
        }



    .avatar-img {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        border: 4px solid var(--electron-blue);
        object-fit: cover;
        box-shadow: var(--neon-glow);
        margin-bottom: 20px;
    }

    .user-name {
        font-family: 'Orbitron', sans-serif;
        font-size: 2.2rem;
        letter-spacing: 2px;
        color: #fff;
        margin-bottom: 10px;
    }

    .info-box {
        background: rgba(0, 0, 0, 0.3);
        border-radius: 15px;
        padding: 15px;
        margin-bottom: 15px;
        border-left: 3px solid var(--electron-blue);
    }

    .info-label {
        color: var(--electron-blue);
        font-size: 0.75rem;
        font-weight: bold;
        text-transform: uppercase;
    }

    .btn-edit {
        background: linear-gradient(45deg, #00d4ff, #0055ff);
        border: none;
        color: white;
        padding: 12px 40px;
        border-radius: 50px;
        font-weight: bold;
        text-transform: uppercase;
        box-shadow: 0 5px 15px rgba(0, 212, 255, 0.4);
        transition: 0.3s;
    }

        .btn-edit:hover {
            transform: scale(1.05);
            box-shadow: 0 0 25px var(--electron-blue);
            color: white;
        }

    footer {
        margin-top: 30px;
        font-size: 0.8rem;
        opacity: 0.5;
        color: #fff;
    }
</style>

    <div class="container main-wrapper">
        <div class="row justify-content-center text-center">
            <div class="col-lg-6 col-md-8">
            <div class="profile-card">
                @* 2. HIỂN THỊ HÌNH ẢNH THẬT TỪ DATABASE *@
                <img src="@(string.IsNullOrEmpty(Model.AvatarUrl) ? "https://i.pravatar.cc/300" : Model.AvatarUrl)"
                     alt="User Avatar" class="avatar-img">

                @* Hiển thị FullName từ database *@
                <h2 class="user-name">@Model.FullName.ToUpper()</h2>

                <div class="row mt-4">
                    <div class="col-12">
                        <div class="info-box text-start">
                            <div class="info-label">Họ Và Tên</div>
                            @* Hiển thị Email từ database *@
                            <div class="fs-5">@Model.FullName</div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="info-box text-start">
                            <div class="info-label">Email Address</div>
                            @* Hiển thị Email từ database *@
                            <div class="fs-5">@Model.Email</div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="info-box text-start">
                            <div class="info-label">Access Level</div>
                            <div class="fs-5 text-info">
                                @* Kiểm tra quyền để hiển thị *@
                                @(User.IsInRole("Admin") ? "Quản trị viên hệ thống" : "Thành viên")
                            </div>
                        </div>
                    </div>
                </div>

                <a asp-controller="Account" asp-action="ChangeTaiKhoan" class="btn-edit">Chỉnh Sửa Thông Tin</a>
            </div>

                <footer>
                    &copy; 2026 - QuanLyThuVien_VB - <a href="#" class="text-info text-decoration-none">Privacy</a>
                </footer>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
