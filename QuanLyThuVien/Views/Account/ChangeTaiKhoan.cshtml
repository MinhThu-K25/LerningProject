@model QuanLyThuVien.Models.AppUser
@{
    ViewData["Title"] = "Chỉnh Sửa Thông Tin";
    // Layout = null;
}

<style>
    :root {
        --electron-blue: #00d4ff;
        --neon-glow: 0 0 15px rgba(0, 212, 255, 0.6);
        --dark-bg: #050a18;
        --card-bg: rgba(17, 34, 64, 0.8);
    }

    body {
        background: radial-gradient(circle at center, #0a192f 0%, #050a18 100%);
        color: #e6f1ff;
        font-family: 'Roboto', sans-serif;
        min-height: 100vh;
        margin: 0;
        overflow-x: hidden;
    }

    .edit-card {
         margin-bottom: 46px; /* Cách footer một khoảng 30px */
        background: var(--card-bg);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(0, 212, 255, 0.2);
        border-radius: 25px;
        padding: 3rem;
        width: 100%;
        max-width: 550px;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5);
    }

    /* Avatar Edit Section */
    .avatar-edit-wrapper {
        position: relative;
        width: 130px;
        height: 130px;
        margin: 0 auto 2rem;
    }

    .avatar-preview {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid var(--electron-blue);
        box-shadow: 0 0 15px rgba(0, 212, 255, 0.4);
    }

    .btn-change-photo {
        position: absolute;
        bottom: 0;
        right: 0;
        background: var(--electron-blue);
        border: none;
        border-radius: 50%;
        width: 35px;
        height: 35px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #050a18;
        cursor: pointer;
        font-size: 1.2rem;
        transition: 0.3s;
    }

    /* Form Styling */
    .form-label {
        color: var(--electron-blue);
        font-family: 'Orbitron', sans-serif;
        font-size: 0.8rem;
        letter-spacing: 1px;
        margin-bottom: 8px;
    }

    .form-control, .form-select {
        background-color: var(--input-bg);
        border: 1px solid rgba(0, 212, 255, 0.3);
        color: white !important;
        border-radius: 10px;
        padding: 12px 15px;
        transition: all 0.3s ease;
    }

        .form-control:focus, .form-select:focus {
            background-color: rgba(10, 25, 47, 0.9);
            border-color: var(--electron-blue);
            box-shadow: 0 0 10px rgba(0, 212, 255, 0.5);
            outline: none;
        }

    /* Custom Select Arrow for Dark Mode */
    .form-select {
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%2300d4ff' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m2 5 6 6 6-6'/%3e%3c/svg%3e");
    }

    .title-edit {
        font-family: 'Orbitron', sans-serif;
        text-align: center;
        margin-bottom: 2rem;
        color: #fff;
        text-shadow: 0 0 10px var(--electron-blue);
    }

    .btn-save {
        background: linear-gradient(45deg, #00d4ff, #0055ff);
        border: none;
        color: white;
        padding: 12px 0;
        border-radius: 12px;
        font-weight: bold;
        font-family: 'Orbitron', sans-serif;
        text-transform: uppercase;
        width: 100%;
        margin-top: 2rem;
        transition: 0.3s;
        box-shadow: 0 5px 15px rgba(0, 85, 255, 0.3);
    }

        .btn-save:hover {
            transform: translateY(-2px);
            box-shadow: 0 0 20px var(--electron-blue);
        }

    .btn-cancel {
        color: #aaa;
        text-decoration: none;
        font-size: 0.9rem;
        display: block;
        text-align: center;
        margin-top: 15px;
        transition: 0.3s;
    }

        .btn-cancel:hover {
            color: #ff4d4d;
        }
</style>

    <div class="container d-flex justify-content-center">
        <div class="edit-card">
            <h3 class="title-edit">CHỈNH SỬA HỒ SƠ</h3>

        <form asp-action="ChangeTaiKhoan" method="post" enctype="multipart/form-data">
            <div class="avatar-edit-wrapper">
                <img src="@(string.IsNullOrEmpty(Model.AvatarUrl) ? "https://i.pravatar.cc/300" : Model.AvatarUrl)"
                     alt="Avatar" class="avatar-preview" id="previewImg">

                <label for="fileInput" class="btn-change-photo">
                    📷
                </label>
                <input type="file" name="ImageFile" id="fileInput" style="display: none;" accept="image/*">
            </div>

            <div class="mb-3">
                <label class="form-label">Họ và Tên</label>
                <input type="text" asp-for="FullName" class="form-control" placeholder="Nhập họ tên...">
            </div>

            <div class="mb-3">
                <label class="form-label">Email Liên Hệ</label>
                <input type="email" asp-for="Email" class="form-control" placeholder="name@example.com">
            </div>

            @* Nếu bạn muốn hiển thị quyền (Access Level) như trong ảnh mẫu *@
            <div class="col-12">
                <div class="info-box text-start">
                    <div class="info-label">Access Level</div>
                    <div class="fs-5 text-info">
                        @* Kiểm tra quyền để hiển thị *@
                        @(User.IsInRole("Admin") ? "Quản trị viên hệ thống" : "Thành viên")
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-save">Lưu Thay Đổi</button>

            <a asp-action="Index" class="btn-cancel">Hủy bỏ</a>
        </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Hiển thị ảnh ngay khi chọn file
        document.getElementById('fileInput').onchange = evt => {
            const [file] = evt.target.files
            if (file) {
                document.getElementById('previewImg').src = URL.createObjectURL(file)
            }
        }
    </script>
