@{
    ViewData["Title"] = "Đăng Ký";
    Layout = null;
}
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    /* Tạo một vùng chứa bao quanh để đẩy form ra giữa */
    .main-wrapper {
        display: flex; /* Kích hoạt Flexbox */
        align-items: center; /* Căn giữa theo chiều dọc */
        justify-content: center; /* Căn giữa theo chiều ngang */
        min-height: calc(100vh - 60px); /* Chiều cao bằng màn hình trừ header */
        width: 100%;
        padding: 50px 20px; /* Cách trên và dưới 50px để không dính Header/Footer */
    }

    body {
        font-family: 'Inter', sans-serif;
        background-color: #e3f2fd; /* Màu nền blue nhẹ chuẩn */
        margin: 0;
    }

    .register-container {
        margin-bottom: 46px; /* Cách footer một khoảng 30px */
        background-color: white;
        display: flex;
        border-radius: 20px; /* Bo góc tròn hơn giống ảnh */
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        max-width: 1000px;
        width: 100%;
    }

    .image-section {
        flex: 1;
        background-image: url('https://images.unsplash.com/photo-1507842217343-583bb7270b66?q=80&w=2000&auto=format&fit=crop');
        background-size: cover;
        background-position: center;
        min-height: 550px;
    }

    .form-section {
        flex: 1.1;
        padding: 50px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .form-control {
        background-color: #f8f9fa !important;
        border: none !important;
        padding: 12px 15px !important;
        border-radius: 8px !important;
    }

    .btn-register {
        background-color: #0d6efd;
        border: none;
        padding: 14px;
        font-weight: bold;
        border-radius: 8px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }
</style>

<div class="main-wrapper">
<div class="register-container">
    <div class="image-section d-none d-md-block"></div>

    <div class="form-section">
        <div class="text-center mb-3">
            <img src="https://cdn-icons-png.flaticon.com/512/1077/1077114.png" width="50" alt="icon" />
        </div>
        <h3 class="text-center fw-bold">Đăng ký tài khoản</h3>
        <p class="text-center text-muted">Hệ thống Quản lý Thư viện</p>

            <form asp-action="Register" method="post">
                <div class="mb-3">
                    <label class="form-label text-uppercase small fw-bold">Họ và Tên</label>
                    @* Phải có name="fullName" hoặc tên tương ứng trong C# *@
                    <input name="fullName" type="text" class="form-control border-0 bg-light" placeholder="Nhập họ và tên" style="padding: 12px;">
                </div>

                <div class="mb-3">
                    <label class="form-label text-uppercase small fw-bold">Email</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-envelope text-muted"></i></span>
                        @* Xóa value="Email", thêm required và placeholder *@
                        <input type="email" name="Email" class="form-control"
                               placeholder="example@gmail.com" required
                               title="Vui lòng nhập đúng định dạng email (ví dụ: abc@gmail.com)">
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-6">
                        <label class="form-label text-uppercase small fw-bold">Mật khẩu mới</label>
                        <div class="input-group">
                            <input name="password" type="password" id="password"
                                   class="form-control border-0 bg-light"
                                   placeholder="Mật khẩu"
                                   style="padding: 12px;"
                                   required
                                   @* Chống trình duyệt tự điền mật khẩu cũ *@
                                   autocomplete="new-password"
                                   pattern="^[A-Z].{7,}$"
                                   title="Mật khẩu phải bắt đầu bằng chữ hoa và dài ít nhất 8 ký tự">
                            <button class="btn btn-light border-0" type="button" onclick="togglePassword('password', 'icon1')">
                                <i class="fas fa-eye-slash" id="icon1"></i>
                            </button>
                        </div>
                    </div>

                    <div class="col-6">
                        <label class="form-label text-uppercase small fw-bold">Xác nhận</label>
                        <div class="input-group">
                            <input name="confirmPassword" type="password" id="confirmPassword" class="form-control border-0 bg-light" placeholder="Xác nhận" style="padding: 12px;" required>
                            <button class="btn btn-light border-0" type="button" onclick="togglePassword('confirmPassword', 'icon2')">
                                <i class="fas fa-eye-slash" id="icon2"></i>
                            </button>
                        </div>
                    </div>

                    <div class="col-12 mt-2">
                        <div class="p-2 border-start border-primary border-3 bg-light" style="font-size: 0.75rem; color: #555;">
                            <strong>Yêu cầu mật khẩu:</strong>
                            <ul class="mb-0 ps-3">
                                <li>Tối thiểu <strong>8 ký tự</strong>.</li>
                                <li>Chữ cái <strong>đầu tiên phải viết hoa</strong>.</li>
                                <li>Phải có ít nhất <strong>1 chữ số</strong> và <strong>1 ký tự đặc biệt</strong> (@@, #, $, !...).</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn-register">
                    <i class="bi bi-person-check me-2"></i>Đăng ký
                </button>

                <div class="text-center mt-3" style="font-size:0.85rem;">
                    Đã có tài khoản?
                    <a asp-controller="Account" asp-action="Login"
                       class="text-primary fw-semibold">
                        Đăng nhập
                    </a>
                </div>
        </form>
    </div>
</div>
</div>
<!-- Bootstrap JS Bundle with Popper -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script>
    function togglePassword(inputId, iconId) {
        const passwordInput = document.getElementById(inputId);
        const eyeIcon = document.getElementById(iconId);

        if (passwordInput.type === "password") {
            // Hiện mật khẩu
            passwordInput.type = "text";
            // Đổi icon sang mắt mở
            eyeIcon.classList.remove("fa-eye-slash");
            eyeIcon.classList.add("fa-eye");
        } else {
            // Ẩn mật khẩu
            passwordInput.type = "password";
            // Đổi icon sang mắt đóng (có gạch chéo)
            eyeIcon.classList.remove("fa-eye");
            eyeIcon.classList.add("fa-eye-slash");
        }
    }
</script>