@model QuanLyThuVien.Models.PhieuPhat

@{
    ViewData["Title"] = "Chi tiết Phiếu phạt";
}

<div class="container-fluid py-4">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
        <h4 class="fw-bold mb-0">Thông tin chi tiết Phiếu phạt #@Model.FineId</h4>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title fw-bold mb-3">Thông tin thành viên</h5>
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                            <i class="bi bi-person fs-4"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-dark">@Model.Member?.FullName</div>
                            <div class="text-muted small">Mã thành viên: @Model.MemberId</div>
                        </div>
                    </div>
                    <hr>
                    <div class="mb-2">
                        <span class="text-muted small d-block">Trạng thái phiếu:</span>
                        @if (Model.IsPaid)
                        {
                            <span class="badge bg-success mt-1 px-3 py-2">
                                <i class="bi bi-check-circle me-1"></i> Đã thanh toán
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger mt-1 px-3 py-2">
                                <i class="bi bi-clock-history me-1"></i> Chưa thanh toán
                            </span>
                        }
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm bg-light">
                <div class="card-body text-center">
                    <span class="text-muted text-uppercase small fw-bold">Tổng tiền phạt</span>
                    <h2 class="text-danger fw-bold my-2">@Model.TotalFine.ToString("N0") VNĐ</h2>
                    <p class="text-muted mb-0">Quá hạn: <strong>@Model.OverdueDays ngày</strong></p>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="card-title fw-bold mb-0">Danh sách sách vi phạm</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Tên sách</th>
                                    <th class="text-center">Ngày mượn</th>
                                    <th class="text-center">Ngày hẹn trả</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.BorrowRecord?.BorrowDetails != null)
                                {
                                    @foreach (var detail in Model.BorrowRecord.BorrowDetails)
                                    {
                                        <tr>
                                            <td class="ps-3">
                                                <div class="fw-semibold text-primary">@detail.Book?.TenSach</div>
                                                @* <div class="text-muted small">ISBN: @detail.Book?.IS</div> *@
                                            </td>
                                            <td class="text-center">@Model.BorrowRecord.BorrowDate.ToString("dd/MM/yyyy")</td>
                                            <td class="text-center">@Model.BorrowRecord.DueDate.ToString("dd/MM/yyyy")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center py-4 text-muted">Không có dữ liệu chi tiết sách.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h5 class="card-title fw-bold mb-0">Thông tin giao dịch</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-sm-6 mb-3">
                            <label class="text-muted small d-block">Ngày thanh toán</label>
                            <span class="fw-semibold">@(Model.PaidAt?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa thanh toán")</span>
                        </div>
                        <div class="col-sm-6 mb-3 text-sm-end">
                            @if (!Model.IsPaid)
                            {
                                <form asp-action="MarkPaid" asp-route-id="@Model.FineId" method="post" onsubmit="return confirm('Xác nhận thu tiền?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-success">
                                        <i class="bi bi-cash me-1"></i> Xác nhận thanh toán ngay
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>