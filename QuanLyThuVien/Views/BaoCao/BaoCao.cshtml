@{
    ViewData["Title"] = "Dashboard Thống Kê Tổng Hợp";
}

<!-- CSS giữ nguyên phong cách hiện đại của bạn -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
    :root {
        --primary-color: #4361ee;
        --secondary-color: #3f37c9;
        --success-color: #4cc9f0;
        --bg-light: #f8f9fc;
        --danger-soft: #fff5f5;
    }

    body {
        background-color: var(--bg-light);
        font-family: 'Inter', sans-serif;
    }

    .stat-card {
        border: none;
        border-radius: 15px;
        transition: all 0.3s ease;
    }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.05) !important;
        }

    .card-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 1.5rem;
    }

    .chart-container {
        position: relative;
        height: 300px;
        width: 100%;
    }

    .table-container {
        background: white;
        border-radius: 15px;
        overflow: hidden;
    }
</style>

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-0 text-dark">@ViewData["Title"]</h3>
            <p class="text-muted small">Dữ liệu tổng hợp từ Sách, Thành viên, Mượn trả và Phiếu phạt</p>
        </div>
        <div class="d-flex gap-2">
            <select class="form-select form-select-sm" style="width: 150px;">
                <option>Tháng này</option>
                <option>Quý này</option>
                <option>Năm 2024</option>
            </select>
            <button class="btn btn-primary btn-sm d-flex align-items-center gap-2" onclick="window.print()">
                <i class="bi bi-printer"></i> Xuất PDF
            </button>
        </div>
    </div>

    <!-- Hàng 1: 4 Model Stats -->
    <div class="row g-3 mb-4">
        <!-- Model: Sách -->
        <div class="col-md-3">
            <div class="card stat-card shadow-sm p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted small mb-1 fw-bold">TỔNG SÁCH</p>
                        <h3 class="fw-bold mb-0">2,450</h3>
                    </div>
                    <div class="card-icon bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-book"></i>
                    </div>
                </div>
                <div class="mt-2 text-success small"><i class="bi bi-plus"></i> 12 đầu sách mới</div>
            </div>
        </div>
        <!-- Model: Thành Viên -->
        <div class="col-md-3">
            <div class="card stat-card shadow-sm p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted small mb-1 fw-bold">THÀNH VIÊN</p>
                        <h3 class="fw-bold mb-0">1,120</h3>
                    </div>
                    <div class="card-icon bg-success bg-opacity-10 text-success">
                        <i class="bi bi-people"></i>
                    </div>
                </div>
                <div class="mt-2 text-muted small">890 thành viên active</div>
            </div>
        </div>
        <!-- Model: Phiếu Mượn -->
        <div class="col-md-3">
            <div class="card stat-card shadow-sm p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted small mb-1 fw-bold">LƯỢT MƯỢN</p>
                        <h3 class="fw-bold mb-0 text-info">342</h3>
                    </div>
                    <div class="card-icon bg-info bg-opacity-10 text-info">
                        <i class="bi bi-arrow-left-right"></i>
                    </div>
                </div>
                <div class="mt-2 text-info small">Tăng 5% so với tuần trước</div>
            </div>
        </div>
        <!-- Model: Phiếu Phạt -->
        <div class="col-md-3">
            <div class="card stat-card shadow-sm p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted small mb-1 fw-bold">TIỀN PHẠT</p>
                        <h3 class="fw-bold mb-0 text-danger">1.250k</h3>
                    </div>
                    <div class="card-icon bg-danger bg-opacity-10 text-danger">
                        <i class="bi bi-currency-dollar"></i>
                    </div>
                </div>
                <div class="mt-2 text-danger small fw-bold">12 phiếu chưa thu</div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row g-4 mb-4">
        <!-- Biểu đồ mượn trả (Model: Phiếu Mượn) -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm p-4 h-100" style="border-radius: 15px;">
                <div class="d-flex justify-content-between mb-4">
                    <h5 class="fw-bold">Hiệu suất Mượn & Trả</h5>
                    <div class="small text-muted">Đơn vị: Cuốn</div>
                </div>
                <div class="chart-container">
                    <canvas id="borrowReturnChart"></canvas>
                </div>
            </div>
        </div>
        <!-- Biểu đồ lý do phạt (Model: Phiếu Phạt) -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm p-4 h-100" style="border-radius: 15px;">
                <h5 class="fw-bold mb-4">Lý do bị Phạt</h5>
                <div class="chart-container">
                    <canvas id="fineReasonChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Alert Tables Row -->
    <div class="row g-4">
        <!-- Bảng 1: Quá hạn (Model: Phiếu Mượn + Sách + TV) -->
        <div class="col-md-7">
            <div class="card border-0 shadow-sm table-container">
                <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0 text-danger"><i class="bi bi-clock-history me-2"></i>Sách quá hạn chưa trả</h6>
                    <a href="#" class="btn btn-sm btn-link text-decoration-none p-0">Xem tất cả</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                        <thead class="table-light text-muted">
                            <tr>
                                <th class="ps-3">Bạn đọc</th>
                                <th>Tên sách</th>
                                <th>Quá hạn</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="ps-3"><strong>Nguyễn Văn A</strong></td>
                                <td>ASP.NET Core MVC</td>
                                <td><span class="badge bg-danger bg-opacity-10 text-danger">12 ngày</span></td>
                                <td><button class="btn btn-sm btn-light py-0 px-2"><i class="bi bi-bell"></i></button></td>
                            </tr>
                            <tr>
                                <td class="ps-3"><strong>Trần Thị B</strong></td>
                                <td>Clean Code</td>
                                <td><span class="badge bg-danger bg-opacity-10 text-danger">5 ngày</span></td>
                                <td><button class="btn btn-sm btn-light py-0 px-2"><i class="bi bi-bell"></i></button></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Bảng 2: Phiếu phạt gần đây (Model: Phiếu Phạt) -->
        <div class="col-md-5">
            <div class="card border-0 shadow-sm table-container">
                <div class="card-header bg-white border-0 py-3">
                    <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-receipt me-2"></i>Phiếu phạt mới nhất</h6>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Lý do</th>
                                <th>Số tiền</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="ps-3">Làm hỏng sách</td>
                                <td class="fw-bold">50.000đ</td>
                                <td><i class="bi bi-check-circle-fill text-success"></i></td>
                            </tr>
                            <tr>
                                <td class="ps-3">Quá hạn (10d)</td>
                                <td class="fw-bold">20.000đ</td>
                                <td><i class="bi bi-x-circle-fill text-warning"></i></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // 1. Biểu đồ Mượn - Trả (Data mẫu cho Phiếu Mượn)
    const ctxBorrow = document.getElementById('borrowReturnChart').getContext('2d');
    new Chart(ctxBorrow, {
        type: 'line',
        data: {
            labels: ['T2', 'T3', 'T4', 'T5', 'T6', 'T7', 'CN'],
            datasets: [{
                label: 'Sách Mượn',
                data: [65, 59, 80, 81, 56, 40, 30],
                borderColor: '#4361ee',
                backgroundColor: 'rgba(67, 97, 238, 0.1)',
                fill: true,
                tension: 0.4
            }, {
                label: 'Sách Trả',
                data: [45, 48, 40, 60, 70, 35, 25],
                borderColor: '#4cc9f0',
                backgroundColor: 'transparent',
                borderDash: [5, 5],
                tension: 0.4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { position: 'top', align: 'end' } },
            scales: { y: { beginAtZero: true }, x: { grid: { display: false } } }
        }
    });

    // 2. Biểu đồ Lý do phạt (Data mẫu cho Phiếu Phạt)
    const ctxFine = document.getElementById('fineReasonChart').getContext('2d');
    new Chart(ctxFine, {
        type: 'doughnut',
        data: {
            labels: ['Quá hạn', 'Mất sách', 'Hư hỏng'],
            datasets: [{
                data: [70, 10, 20],
                backgroundColor: ['#4361ee', '#f72585', '#4cc9f0'],
                borderWidth: 5,
                borderColor: '#ffffff'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { position: 'bottom' }
            },
            cutout: '75%'
        }
    });
</script>
