@model IEnumerable<QuanLyThuVien.Models.ThanhVien>

@{
    ViewData["Title"] = "Quản lý thành viên";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0">
        <i class="bi bi-people-fill me-2 text-primary"></i>Quản lý thành viên
    </h4>
    @* --- LIÊN KẾT NÚT THÊM THÀNH VIÊN --- *@
    <a asp-action="Create" class="btn btn-primary shadow-sm px-3">
        <i class="bi bi-plus-lg me-1"></i> Thêm thành viên
    </a>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2">
            <div class="col-md-6">
                <div class="input-group">
                    <input type="text" name="searchString" class="form-control border-end-0"
                           placeholder="Tìm theo tên, CMND, số điện thoại..." value="@ViewBag.CurrentFilter" />
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-search me-1"></i> Tìm
                    </button>
                </div>
            </div>
            <div class="col-md-auto">
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Xóa lọc</a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-3" style="width: 120px;">Mã thẻ (ID)</th>
                        @* <th>Hệ thống (User)</th> *@
                        <th>Họ và tên</th>
                        <th>Email</th>
                        <th>Điện thoại</th>
                        <th>CMND/CCCD</th>
                        <th class="text-center">Ngày tham gia</th>
                        <th class="text-center">Hết hạn thẻ</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-center" style="width: 120px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-person-exclamation fs-2 d-block mb-2"></i>
                                Không tìm thấy thành viên nào.
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-3">
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                    @item.MemberId
                                </span>
                            </td>
                            @* <td>
                                <div class="small text-muted" style="font-size: 0.75rem;">
                                    <strong>UserID:</strong> @(string.IsNullOrEmpty(item.UserId) ? "CHƯA LIÊN KẾT" : item.UserId)
                                </div>
                            </td> *@
                            <td>
                                <div class="fw-bold text-dark">@item.FullName</div>
                                
                            </td>
                            <td>
                                <div class="text-muted small">@item.Email</div>
                            </td>
                            <td class="text-muted">@(item.PhoneNumber ?? "—")</td>
                            <td class="text-muted">@(item.CMND ?? "—")</td>
                            <td class="text-center small">@item.JoinDate.ToString("dd/MM/yyyy")</td>
                            <td class="text-center small">
                                @item.ExpireDate?.ToString("dd/MM/yyyy")
                            </td>
                            <td class="text-center">
                                @* --- LOGIC HIỂN THỊ TRẠNG THÁI THEO MÀU SẮC YÊU CẦU --- *@
                                @if (!item.IsActive)
                                {
                                    <span class="badge bg-danger rounded-pill px-3" title="Vi phạm nội quy hoặc mất thẻ">
                                        <i class="bi bi-lock-fill me-1"></i> Đã khóa
                                    </span>
                                }
                                else if (item.ExpireDate < DateTime.Now)
                                {
                                    <span class="badge bg-warning text-dark rounded-pill px-3" title="Cần gia hạn thẻ để tiếp tục">
                                        <i class="bi bi-exclamation-triangle-fill me-1"></i> Hết hạn
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success rounded-pill px-3" title="Thẻ hợp lệ, được phép mượn sách">
                                        <i class="bi bi-check-circle-fill me-1"></i> Đang hoạt động
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group shadow-sm border rounded">
                                    @* --- NÚT SỬA (ICON CÂY BÚT) --- *@
                                    <a asp-action="Edit" asp-route-id="@item.MemberId"
                                       class="btn btn-sm btn-white border-0 text-primary" title="Sửa thông tin">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    @* --- NÚT KHÓA/MỞ KHÓA (ICON CÁI KHÓA) --- *@
                                    <a asp-action="ToggleStatus" asp-route-id="@item.MemberId"
                                       class="btn btn-sm btn-white border-0 @(item.IsActive ? "text-danger" : "text-success")"
                                       title="@(item.IsActive ? "Khóa tài khoản" : "Mở khóa tài khoản")">
                                        <i class="bi @(item.IsActive ? "bi-lock" : "bi-unlock")"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.MemberId" method="post"
                                          onsubmit="return confirm('Bạn có chắc chắn muốn xóa thành viên @item.FullName này không?');"
                                          style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-white border-0 text-danger" title="Xóa thành viên">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer bg-white py-3 border-0">
        <span class="text-muted small">Tổng cộng: <strong>@Model.Count()</strong> thành viên</span>
    </div>
</div>

<style>
    .bg-primary-subtle {
        background-color: #eef2ff !important;
    }

    .table thead th {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 700;
        color: #555;
        border-top: none;
    }

    .btn-white {
        background-color: #fff;
    }

        .btn-white:hover {
            background-color: #f8f9fa;
        }

    .table-hover tbody tr:hover {
        background-color: #fcfcfc;
    }
    /* Màu sắc tùy chỉnh cho Badge trạng thái */
    .badge {
        font-weight: 500;
    }
</style>