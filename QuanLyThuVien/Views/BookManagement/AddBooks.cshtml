@model QuanLyThuVien.Models.BookManagement
@{
    ViewData["Title"] = "Thêm sách mới";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header fw-bold border-0" style="background:#f0f4f8;">
                <i class="bi bi-plus-circle me-1 text-primary"></i> Thêm sách mới vào thư viện
            </div>
            <div class="card-body">
                <form asp-action="AddBooks" enctype="multipart/form-data" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row g-3">
                        @* Mã Sách *@
                        <div class="col-md-4">
                            <label asp-for="MaSach" class="form-label fw-semibold"></label>
                            <input asp-for="MaSach" class="form-control" placeholder="VD: MS001" />
                            <span asp-validation-for="MaSach" class="text-danger small"></span>
                        </div>

                        @* Tên Sách *@
                        <div class="col-md-8">
                            <label asp-for="TenSach" class="form-label fw-semibold"></label>
                            <input asp-for="TenSach" class="form-control" placeholder="Nhập tên sách..." />
                            <span asp-validation-for="TenSach" class="text-danger small"></span>
                        </div>

                        @* Tác Giả *@
                        <div class="col-md-6">
                            <label asp-for="TacGia" class="form-label fw-semibold"></label>
                            <input asp-for="TacGia" class="form-control" placeholder="Tên tác giả..." />
                        </div>

                        @* Thể Loại *@
                        <div class="col-md-6">
                            <label asp-for="TheLoai" class="form-label fw-semibold"></label>
                            <input asp-for="TheLoai" class="form-control" placeholder="VD: Kỹ năng sống, CNTT..." />
                        </div>

                        @* Nhà Xuất Bản *@
                        <div class="col-md-6">
                            <label asp-for="NhaXuatBan" class="form-label fw-semibold"></label>
                            <input asp-for="NhaXuatBan" class="form-control" placeholder="Nhà xuất bản..." />
                        </div>

                        @* Năm Xuất Bản *@
                        <div class="col-md-3">
                            <label asp-for="NamXuatBan" class="form-label fw-semibold"></label>
                            <input asp-for="NamXuatBan" class="form-control" placeholder="VD: 2024" />
                        </div>

                        @* Tái Bản *@
                        <div class="col-md-3">
                            <label asp-for="TaiBan" class="form-label fw-semibold"></label>
                            <input asp-for="TaiBan" class="form-control" placeholder="Lần thứ..." />
                        </div>

                        @* Kho *@
                        <div class="col-md-6">
                            <label asp-for="Kho" class="form-label fw-semibold"></label>
                            <input asp-for="Kho" class="form-control" placeholder="Vị trí kệ sách..." />
                        </div>

                        @* Ảnh Bìa *@
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Tải lên ảnh bìa</label>
                            <input type="file" name="fileAnh" class="form-control" accept="image/*" />
                        </div>

                        @* Mô Tả Nội Dung *@
                        <div class="col-12">
                            <label asp-for="MoTaNoiDung" class="form-label fw-semibold"></label>
                            <textarea asp-for="MoTaNoiDung" class="form-control" rows="3"
                                      placeholder="Tóm tắt nội dung chính của sách..."></textarea>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-save me-1"></i> Lưu thông tin
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Quay lại</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}