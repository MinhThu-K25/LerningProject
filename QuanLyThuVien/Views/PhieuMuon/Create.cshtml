@using QuanLyThuVien.Models
@{
    ViewData["Title"] = "Tạo phiếu mượn";
    var books = ViewBag.Books as List<BookManagement>;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="mb-4">
                <h4 class="fw-bold text-dark mb-1">Tạo phiếu mượn</h4>
                <div class="text-muted small">Quản lý việc mượn sách của thành viên</div>
            </div>
            @if (TempData["Warning"] != null)

            {

                <div class="alert alert-warning alert-dismissible fade show">

                    @TempData["Warning"]

                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>

                </div>

            }
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; overflow: hidden;">
                    <div class="card-header py-3" style="background: #2e75b6; color: white;">
                        <i class="bi bi-journal-text me-2"></i><strong>Thông tin mượn</strong>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small text-uppercase text-muted">Thành viên <span class="text-danger">*</span></label>
                                <select name="MemberId" class="form-select" required>
                                    <option value="">-- Chọn thành viên --</option>
                                    @if (ViewBag.Members != null)
                                    {
                                        @* Dùng dynamic hoặc IEnumerable<SelectListItem> đều được *@
                                        foreach (var item in (IEnumerable<SelectListItem>)ViewBag.Members)
                                        {
                                            <option value="@item.Value">@item.Text</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small text-uppercase text-muted">CMND/CCCD</label>
                                <input type="text" id="cmndDisplay" class="form-control bg-light"
                                       placeholder="Chọn thành viên để xem CMND" readonly />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold small text-uppercase text-muted">Hạn trả <span class="text-danger">*</span></label>
                                <input type="date" name="DueDate" class="form-control"
                                       value="@DateTime.Today.AddDays(14).ToString("yyyy-MM-dd")"
                                       min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                                <div class="form-text mt-1" style="font-size: 0.8rem;">Mặc định 14 ngày kể từ hôm nay</div>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold small text-uppercase text-muted">Ghi chú</label>
                                <textarea name="Notes" class="form-control" rows="2" placeholder="Ghi chú thêm nếu có..."></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; overflow: hidden;">
                    <div class="card-header py-3 d-flex justify-content-between align-items-center" style="background: #2e75b6; color: white;">
                        <span><i class="bi bi-book me-2"></i><strong>Chọn sách</strong></span>
                        <span class="badge bg-white text-primary" id="selectedCount">0 sách đã chọn</span>
                    </div>
                    <div class="card-body p-0">
                        @if (books == null || !books.Any())
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                <p>Không có sách nào sẵn có để mượn.</p>
                            </div>
                        }
                        else
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var book in books)
                                {
                                    <label class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3 book-item">
                                        <input class="form-check-input book-check flex-shrink-0"
                                               type="checkbox"
                                               name="bookIds" value="@book.MaSach"
                                               style="width: 20px; height: 20px;">

                                        <div class="flex-grow-1">
                                            <div class="fw-bold text-dark">@book.TenSach</div>
                                            <div class="small text-muted">
                                                <i class="bi bi-person me-1"></i>@book.TacGia
                                                <i class="bi bi-calendar3 ms-3 me-1"></i>@book.NamXuatBan
                                            </div>
                                        </div>

                                        <div class="text-end">
                                            @* <span class="badge rounded-pill mb-1 d-block" style="background-color: #e7f1ff; color: #0d6efd;">
                                                @(book.TheLoai?.CategoryName ?? "Chưa phân loại")
                                            </span> *@
                                            <span class="badge @(book.Kho > 0 ? "bg-success" : "bg-danger")">
                                                Còn @book.Kho
                                            </span>
                                        </div>
                                    </label>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4 py-2 shadow-sm">
                        <i class="bi bi-download me-2"></i>Tạo phiếu
                    </button>
                    <a asp-action="Index" class="btn btn-light border px-4 py-2 text-secondary">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f8f9fa;
    }

    .book-item {
        transition: all 0.2s;
        cursor: pointer;
        border-left: 4px solid transparent;
    }

        .book-item:hover {
            background-color: #f1f7ff;
        }

    .book-check:checked + div {
        font-weight: bold;
    }
    /* Style khi checkbox được chọn (giống ảnh mẫu) */
    .book-item:has(.book-check:checked) {
        background-color: #eef5ff;
        border-left-color: #2e75b6;
    }
</style>

<script>
    // Cập nhật số lượng sách đã chọn
    document.querySelectorAll('.book-check').forEach(checkbox => {
        checkbox.addEventListener('change', function() {
            const count = document.querySelectorAll('.book-check:checked').length;
            document.getElementById('selectedCount').innerText = count + ' sách đã chọn';
        });
    });
    document.querySelector('select[name="MemberId"]').addEventListener('change', function () {
        const memberId = this.value;
        if (!memberId) {
            document.getElementById('cmndDisplay').value = '';
            return;
        }
        fetch(`/ThanhVien/GetCMND?memberId=${memberId}`)
            .then(res => res.json())
            .then(data => {
                document.getElementById('cmndDisplay').value = data.cmnd;
            })
            .catch(() => {
                document.getElementById('cmndDisplay').value = 'Không tìm được';
            });
    });
</script>