@model IEnumerable<QuanLyThuVien.Models.PhieuMuon>
@{
    ViewData["Title"] = "Quản lý Mượn / Trả sách";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <h4 class="fw-bold mb-0">
        <i class="bi bi-arrow-left-right me-2 text-primary"></i>Quản lý Mượn / Trả
    </h4>
    <a asp-action="Create" class="btn btn-primary btn-sm px-3 shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Tạo phiếu mượn mới
    </a>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2">
            <div class="col-md-6">
                <div class="input-group">
                    <input type="text"
                           name="searchString"
                           class="form-control"
                           placeholder="Nhập Tên, SĐT, CMND hoặc Tên sách..."
                           value="@ViewBag.CurrentFilter" /> 
                           <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-search me-1"></i> Tìm
                    </button>
                </div>
            </div>

            <div class="col-md-auto">
                <a asp-action="Index" asp-route-status="@ViewBag.Status" class="btn btn-outline-secondary px-4">Xóa lọc</a>
            </div>
        </form>
    </div>
</div>


@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm py-2">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show border-0 shadow-sm py-2">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Warning"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex gap-2 mb-3">
    <a asp-action="Index" class="btn btn-sm @(ViewBag.Status == null ? "btn-primary" : "btn-outline-secondary")">
        Tất cả
    </a>
    <a asp-action="Index" asp-route-status="Borrowing"
       class="btn btn-sm @(ViewBag.Status == "Borrowing" ? "btn-primary" : "btn-outline-secondary")">
        Đang mượn
    </a>
    <a asp-action="Index" asp-route-status="Overdue"
       class="btn btn-sm @(ViewBag.Status == "Overdue" ? "btn-danger" : "btn-outline-danger")">
        Quá hạn
    </a>
    <a asp-action="Index" asp-route-status="Returned"
       class="btn btn-sm @(ViewBag.Status == "Returned" ? "btn-success" : "btn-outline-success")">
        Đã trả
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr class="bg-light" style="border-bottom: 2px solid #dee2e6;">
                        <th class="ps-3 text-muted" style="width: 80px;">ID</th>
                        <th>Thành viên</th>
                        <th>CMND</th>
                        <th>Sách mượn</th>
                        <th style="width: 130px;">Ngày mượn</th>
                        <th style="width: 130px;">Hạn trả</th>
                        <th class="text-center" style="width: 120px;">Trạng thái</th>
                        <th class="text-center" style="width: 150px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                Không tìm thấy dữ liệu phiếu mượn nào.
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-bold text-muted">#@item.BorrowId</td>
                            <td>
                                @* Giả định bạn đã mở thuộc tính Member trong Model PhieuMuon *@
                                <div class="fw-bold text-dark">
                                    @(item.Member!= null ? item.Member.FullName : "N/A")
                                </div>
                            </td>
                            <td>@item.Member?.CMND</td>
                           
                            <td>
                                @if (item.BorrowDetails != null && item.BorrowDetails.Any())
                                {
                                    @foreach (var detail in item.BorrowDetails)
                                    {
                                        <span class="badge rounded-pill border text-dark fw-normal me-1 mb-1"
                                              style="background-color: #f8f9fa;">
                                            @* Chỉ hiển thị tên sách, nếu null thì hiện thông báo tạm *@
                                            @(detail.Book?.TenSach ?? "Sách không tồn tại")
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">Chưa chọn sách</span>
                                }
                            </td>
                            <td class="small">@item.BorrowDate.ToString("dd/MM/yyyy")</td>
                            <td class="small">
                                @{
                                    var isLate = item.DueDate < DateTime.Today && item.Status != "Returned";
                                }
                                <span class="@(isLate ? "text-danger fw-bold" : "")">
                                    @item.DueDate.ToString("dd/MM/yyyy")
                                </span>
                            </td>
                            <td class="text-center">
                                @if (item.Status == "Returned")
                                {
                                    <span class="badge bg-success">Đã trả</span>
                                }
                                else if (item.DueDate < DateTime.Today)
                                {
                                    <span class="badge bg-danger">Quá hạn</span>
                                }
                                else
                                {
                                    <span class="badge bg-info text-dark">Đang mượn</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group border rounded shadow-sm bg-white">
                                    <a asp-action="Detail" asp-route-id="@item.BorrowId"
                                       class="btn btn-sm btn-light border-0" title="Xem chi tiết">
                                        <i class="bi bi-eye text-primary"></i>
                                    </a>
                                    @if (item.Status != "Returned")
                                    {
                                        <a asp-action="Return" asp-route-id="@item.BorrowId"
                                           class="btn btn-sm btn-light border-0" title="Xử lý trả sách">
                                            <i class="bi bi-box-arrow-in-left text-success"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (Model.Any())
    {
        <div class="card-footer bg-white border-0 py-3 text-muted">
            <small>Hiển thị tổng cộng <strong>@Model.Count()</strong> phiếu mượn.</small>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Tự động đóng alert sau 5 giây
        window.setTimeout(function() {
            $(".alert").fadeTo(500, 0).slideUp(500, function(){
                $(this).remove();
            });
        }, 5000);
        document.addEventListener('DOMContentLoaded', function () {
            const checkboxes = document.querySelectorAll('.book-check');
            const countDisplay = document.getElementById('selectedCount');

            checkboxes.forEach(checkbox => {
                checkbox.addEventListener('change', () => {
                    const selectedCount = document.querySelectorAll('.book-check:checked').length;
                    if (countDisplay) {
                        countDisplay.innerText = `${selectedCount} sách đã chọn`;
                    }
                });
            });
        });
    </script>
}